[Unit]
Description=ListenSSH - Easily report all connection attempts on common vulnerable ports to AbuseIPDB
After=network.target

[Service]
WorkingDirectory=/etc/ListenSSH
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=10

# Optional hardening: run as an unprivileged user that is still allowed to bind
# ports below 1024 via CAP_NET_BIND_SERVICE. Create the user first, then uncomment.
#User=listenssh
#Group=listenssh
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
